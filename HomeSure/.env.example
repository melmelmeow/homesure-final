# HomeSure Next.js Backend Environment Configuration

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Xendit Payment Gateway Configuration
# Found in Xendit Dashboard -> Configuration -> API Keys & Webhooks
XENDIT_SECRET_KEY=xnd_development_your_xendit_secret_key
NEXT_PUBLIC_XENDIT_PUBLIC_KEY=xnd_public_development_your_xendit_public_key
XENDIT_WEBHOOK_VERIFICATION_TOKEN=your_xendit_webhook_verification_token

# Optional: Hostinger / Node Server Settings
PORT=3000
